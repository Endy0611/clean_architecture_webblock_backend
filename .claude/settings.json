{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./docs/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew compileJava *)",
      "Bash(./gradlew spotlessApply *)",
      "Bash(./scripts/gradle-all.sh *)",
      "Bash(python -m pytest *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl apply --dry-run=client *)",
      "mcp__context7__*"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm *)",
      "Bash(curl *)",
      "mcp__dbhub__*",
      "mcp__figma__*",
      "mcp__playwright__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "enabledMcpjsonServers": ["context7", "figma", "playwright", "dbhub"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"", "timeout": 30 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope-guard.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-yaml.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
